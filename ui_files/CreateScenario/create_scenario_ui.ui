       <string notr="true">QPushButton{
	background-color:transparent;
}

QLabel{
	color:#F0F0F0;
	font:bold;
}

QLineEdit{
	background-color:#555555;
	border:1px solid #555555;
	border-radius:10px;
	padding-left:10px;
	color:#F0F0F0;
}

QCheckBox{
	color:#F0F0F0;
}

QCheckBox::indicator:checked{
	image:url(&quot;:/yeniÖnek/fifsot_icons/checked_square.png&quot;);
	width:16px;
	height:16px;
}

QCheckBox::indicator:unchecked{
	image:url(&quot;:/yeniÖnek/fifsot_icons/square.png&quot;);
	width:16px;
	height:16px;
}

QSpinBox{
	background-color:#555555;
	color:#F0F0F0;
}

QSpinBox:up-button{
	subcontrol-position:right;
	width:12px;
	height:12px;
	image:url(&quot;:/yeniÖnek/fifsot_icons/up_arrow_white.png&quot;);
}

QSpinBox:up-button:hover{
	image:url(&quot;:/yeniÖnek/fifsot_icons/up_arrow_blue.png&quot;);
}

QSpinBox:down-button{
	subcontrol-position:left;
	width:12px;
	height:12px;
	image:url(&quot;:/yeniÖnek/fifsot_icons/down_arrow_white.png&quot;);
}

QSpinBox:down-button:hover{
	subcontrol-position:left;
	width:12px;
	height:12px;
	image:url(&quot;:/yeniÖnek/fifsot_icons/down_arrow_blue.png&quot;);
}

QComboBox {
    background-color: #bbbcba;
    border: 2px solid #bbbcba;
    color: #000000;
    border-radius: 10px;
    padding-left: 5px;
    font: 11px;
}
QComboBox QListView {
    background-color: #555555;
    color: #f0f0f0;
    padding: 5px;
    outline: 0px;
    border: 1px solid #555555;
}
QComboBox QListView::item:hover {
    background-color: #be8af9;
    color: #000000;
}
QComboBox QListView::item:selected {
    background-color: #be8af9;
    color: #000000;
}</string>
